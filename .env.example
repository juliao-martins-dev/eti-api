# Copy to .env and fill in. Names only -- real values are never committed.

# Generate a fresh one for production; rotating it invalidates every
# issued JWT, so every teacher is logged out once when you do.
SECRET_KEY=
# Defaults to False. Set True only for local development -- it is what
# serves MEDIA_ROOT and the tracebacks.
DEBUG=True
# Comma separated. '*' accepts any Host header; name the real hosts in
# production.
ALLOWED_HOSTS=

DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Geofence: school coordinates, radius in metres, and whether to enforce it.
ESKOLA_LATITUDE=
ESKOLA_LONGITUDE=
ESKOLA_RAIU_METRU=100
ESKOLA_OBRIGA_FATIN=True

# Login rate limit, counted per client IP. The school shares one
# public address, so this is shared by everyone on the wifi.
THROTTLE_LOGIN=20/min

# Where the audit trail is written. Defaults to ./logs
LOG_DIR=
